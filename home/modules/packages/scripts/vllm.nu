#!/usr/bin/env -S nu --stdin
# vLLM with CUDA, via the official container image.
#
# Why a container and not pkgs.vllm: in nixpkgs vllm is marked
# `broken = cudaSupport` (NixOS/nixpkgs#553566), so a CUDA build needs
# `problems.handlers.vllm.broken = "warn"`, has no cached substitute and
# compiles torch + CUTLASS + DeepGEMM from source. The image gives the same
# CUDA runtime in seconds and picks up the host driver through the NVIDIA
# container toolkit CDI spec generated by the `nvidia` specialisation.

# Keep in sync with the vllm release you actually want to test against.
const IMAGE = "vllm/vllm-openai:v0.24.0"

# PyTorch moves the KV cache through shared memory; the 64M docker default
# makes vLLM refuse to start with "a shared memory limit too low".
const SHM_SIZE = "10g"

const DEFAULT_MODEL = "Qwen/Qwen2.5-1.5B-Instruct"

def fail [msg: string] {
    print -e $"error: ($msg)"
    exit 1
}

def main [
  command: string, # Only `serve` is supported, kept for drop-in compatibility.
  model: string = $DEFAULT_MODEL, # Model id, same as the vLLM CLI.
  ...rest: string, # Passed through to `vllm serve` untouched.
  --image (-i): string = $IMAGE, # Container image to run.
  --port (-p): int = 8000, # Host port the OpenAI server is published on.
  --shm-size: string = $SHM_SIZE, # Shared memory for the KV cache.
  --detach (-d), # Run in the background, print the container name.
  --help (-h), # Show usage.
]: nothing -> nothing {
    if $command != "serve" {
        fail $"unknown command '($command)'. Only 'serve' is supported; see --help."
    }

    # Reuse the host's model cache so weights are downloaded once.
    let hf_cache = ($env.HF_HOME? | default $"($nu.home-dir)/.cache/huggingface")

    if (which docker | is-empty) {
        fail "docker not found on PATH."
    }

    # The host driver lives in /run/opengl-driver and is injected into the
    # container by the CDI spec, so the image never ships its own kernel module.
    let name = $"vllm-($model | str replace --all '/' '_')"

    let args = [
        "run"
        "--rm"
        $"--name=($name)"
        "--gpus" "all"
        "--shm-size" $shm_size
        "--publish" $"($port):8000"
        "--volume" $"($hf_cache):/root/.cache/huggingface"
    ] | append (if $detach { ["--detach"] } else { [] })
      | append [ $image $model ]
      | append $rest

    print -e $"image: ($image)"
    print -e $"model: ($model)"
    print -e $"api:   http://localhost:($port)/v1"

    docker ...$args
}
