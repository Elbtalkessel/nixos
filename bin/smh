#!/usr/bin/env nu

def base-dir [] {
  $env.FILE_PWD | path dirname --num-levels 2
}

def is-root [] {
  (whoami) == "root"
}

# Delete garbage, will remove inactive HM configurations.
def "main cleanup" [] {
  nix-collect-garbage -d
}

# Lists system generations.
def "main lsgen" [] {
  sudo nix-env --profile /nix/var/nix/profiles/system --list-generations
}

# Delete a specified generations. Requires to run cleanup afterwards.
def --wrapped "main degen" [...args] {
  sudo nix-env --profile /nix/var/nix/profiles/system --delete-generations ...$args
}

# Edit secrets.
def "main chsecret" [] {
  nix-shell -p sops --run "sops secrets/secrets.yaml"
}

# Removes generations leaving 1 per day.
def "main squash" [] {
  home-manager generations
  | lines
  | parse '{date} {time} : id {id} -> {path}'
  | group-by date --to-table
  | get items
  | each {|g| $g | slice 1..}
  | flatten
  | each {|it| home-manager remove-generations $it.id}
  | str join "\n"
}

def "main why-depends" [pkg: string] {
  nix why-depends --derivation --impure .#homeConfigurations.risus.activationPackage $".#homeConfigurations.risus.pkgs.($pkg)"
}

def --wrapped "main update" [...args] {
  nix flake update ...$args
}

# home-manager and nixos-rebuild wrapper.
# For `root` user execute nixos-rebuild, otherwise home-manager command.
@example "Apply new home configuration" {smh}
@example "Rebuild and switch to new system configuration" {sudo smh}
@example "Test a new system configuration (without adding boot option)" {sudo smh test}
@example "Rollback home configuration" {smh --rollback}
@example "Package news" {smh news}
def --wrapped "main x" [topic: string = "switch", ...args] {
  if (is-root) {
    nixos-rebuild $topic --accept-flake-config --flake ./ ...$args
  } else {
    home-manager $topic --flake ./ ...$args
  }
}

def main [] {}
