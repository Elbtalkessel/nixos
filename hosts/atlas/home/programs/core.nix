{ config, ... }: {
  programs = {
    devenv = {
      enable = true;
    };

    zsh = {
      enable = true;
      enableCompletion = true;
      syntaxHighlighting.enable = true;
    };

    # fd is a simple, fast and user-friendly alternative to find.
    fd = {
      enable = true;
      hidden = true;
      ignores = [
        ".git/"
        ".devenv/"
        ".venv/"
        "node_modules/"
      ];
    };

    # a fast, modern replacement for grep.
    ripgrep = {
      enable = true;
    };

    git = {
      enable = true;
      signing.format = "openpgp";
      settings = {
        user = {
          name = config.my.username;
          email = "rtfsc+atlas@pm.me";
        };

        init = {
          defaultBranch = "master";
        };

        push = {
          autoSetupRemote = true;
        };
      };
    };
  };

  # Git access to gitea rides the key generated by the atlas-git-key
  # oneshot on the persistent /var/lib/ssh volume. Register the pubkey on
  # the owning gitea account; never store the private key in the Nix store.
  home.file.".ssh/config".text = ''
    Host gitea.x.home.arpa
      IdentityFile /var/lib/ssh/atlas_git_ed25519
      IdentitiesOnly yes
  '';
}
