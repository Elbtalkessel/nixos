{
  "[opencode]": {
    "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",

    "telemetry": false,

    "team_mode": {
      "enabled": true,
      "tmux_visualization": false,
      "max_parallel_members": 4,
      "max_members": 8,
      "max_messages_per_run": 10000,
      "max_wall_clock_minutes": 120,
      "max_member_turns": 500,
      "message_payload_max_bytes": 32768,
      "recipient_unread_max_bytes": 262144,
      "mailbox_poll_interval_ms": 3000
    },

    "agents": {
      "sisyphus": {
        "model": "opencode/big-pickle",
        "fallback_models": [
          {
            "model": "google/gemini-3.1-pro-preview"
          },
          {
            "model": "bazzite.lan/qwen3-8b-amd"
          }
        ]
      },
      "hephaestus": {
        "model": "google/gemini-3.1-pro-preview",
        "reasoning": "medium",
        "fallback_models": [
          {
            "model": "google/gemini-3.6-flash",
            "reasoning": "medium"
          },
          {
            "model": "opencode/big-pickle",
            "reasoning": "medium"
          },
          {
            "model": "bazzite.lan/qwen3-8b-amd",
            "reasoning": "medium"
          }
        ]
      },
      "oracle": {
        "model": "opencode/nemotron-3-ultra-free",
        "reasoning": "high",
        "fallback_models": [
          {
            "model": "google/gemini-3.1-pro-preview",
            "reasoning": "high"
          },
          {
            "model": "google/gemini-3.6-flash",
            "reasoning": "high"
          },
          {
            "model": "opencode/big-pickle",
            "reasoning": "medium"
          },
          {
            "model": "bazzite.lan/qwen3-8b-amd",
            "reasoning": "medium"
          }
        ]
      },
      "momus": {
        "model": "google/gemini-3.1-pro-preview",
        "reasoning": "xhigh",
        "fallback_models": [
          {
            "model": "google/gemini-3.6-flash",
            "reasoning": "high"
          },
          {
            "model": "opencode/big-pickle",
            "reasoning": "medium"
          },
          {
            "model": "bazzite.lan/qwen3-8b-amd",
            "reasoning": "medium"
          }
        ]
      },
      "prometheus": {
        "model": "google/gemini-3.1-pro-preview",
        "reasoning": "high",
        "fallback_models": [
          {
            "model": "google/gemini-3.6-flash",
            "reasoning": "medium"
          },
          {
            "model": "opencode/big-pickle",
            "reasoning": "medium"
          },
          {
            "model": "bazzite.lan/qwen3-8b-amd",
            "reasoning": "medium"
          }
        ]
      },
      "metis": {
        "model": "google/gemini-3.6-flash",
        "reasoning": "medium",
        "fallback_models": [
          {
            "model": "opencode/big-pickle",
            "reasoning": "medium"
          },
          {
            "model": "bazzite.lan/qwen3-8b-amd",
            "reasoning": "medium"
          }
        ]
      },
      "atlas": {
        "model": "bazzite.lan/qwen3-8b-amd",
        "reasoning": "medium",
        "fallback_models": [
          {
            "model": "opencode/big-pickle",
            "reasoning": "medium"
          }
        ]
      },
